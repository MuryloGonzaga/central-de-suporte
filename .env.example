# ===================================================================
# CONFIGURAÇÕES DA CENTRAL DE SUPORTE - APLICAÇÃO WEB
# ===================================================================

# Credenciais de Acesso à API da WebRota (Padrão para recursos gerais)
WEBROTA_USER=seu_usuario_aqui
WEBROTA_PASS=sua_senha_aqui

# Credenciais Dedicadas para o Ranking de OS (Execução em segundo plano)
# Se deixado em branco, utiliza automaticamente o WEBROTA_USER e WEBROTA_PASS acima
WEBROTA_RANKING_USER=
WEBROTA_RANKING_PASS=

# (Opcional) Chave secreta para proteger o endpoint de Cron do Vercel (/api/cron/ranking)
# Se definido, o Vercel enviará o header "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# (Opcional) Armazenamento de Cache em Nuvem para Vercel (Vercel KV ou Upstash Redis)
# No Vercel, o sistema de arquivos da função (/tmp) é temporário entre execuções.
# Se você conectar uma integração KV / Upstash no dashboard do Vercel,
# essas variáveis serão preenchidas automaticamente e o ranking persistirá sem expirar:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# ou via Upstash Redis:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Configurações do Servidor Web (para VPS / Local / Docker)
APP_HOST=0.0.0.0
APP_PORT=8000

# Chave secreta de segurança da aplicação
SECRET_KEY=central_de_suporte_chave_secreta_super_segura_2026

# Modo de desenvolvimento (true/false)
DEBUG=false

# Nome da Aplicação exibido no cabeçalho
APP_NAME=Central de Suporte - Rastreamento & WebRota

# (Opcional) Chave de API Google Gemini para respostas generativas ampliadas
# Caso não informada, o sistema utiliza a Rede Neural Local (MLP) offline 100% gratuita
# GEMINI_API_KEY=sua_chave_gemini_aqui
