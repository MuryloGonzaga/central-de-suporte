APP_PORT=8000

# Chave secreta de segurança da aplicação
SECRET_KEY=central_de_suporte_chave_secreta_super_segura_2026

# Modo de desenvolvimento (true/false)
DEBUG=false

# Nome da Aplicação exibido no cabeçalho
APP_NAME=Central de Suporte - Rastreamento & WebRota

